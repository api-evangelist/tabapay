                      "value": "<string>",
                      "key": "ClientID",
                      "description": "(Required) 22-character <<glossary:ClientID>>. Ask [TabaPay Support](https://tabapay.zendesk.com/hc/en-us/requests/new) if you need to specify a <<glossary:SubClientID>>."
                    },
                    {
                      "description": "Contact [TabaPay Support](https://tabapay.zendesk.com/hc/en-us/requests/new) for the Fully Qualified Domain Name you should be using.",
                      "type": "any",
                      "value": "{{FQDN}}",
                      "key": "FQDN"
                    },
                    {
                      "description": "Ensure you have the capability to access the PORT TabaPay specifies in your credentials file.",
                      "type": "any",
                      "value": "{{PORT}}",
                      "key": "PORT"
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"card\": {\n    \"accountNumber\": \"4111111111111111\",\n    \"expirationDate\": \"202708\",\n    \"securityCode\": \"232\"\n  },\n  \"owner\": {\n    \"name\": {\n      \"first\": \"Test\",\n      \"last\": \"Name\"\n    },\n    \"address\": {\n      \"line1\": \"123 Street\",\n      \"city\": \"San Francisco\",\n      \"state\": \"CA\",\n      \"zipcode\": \"94104\",\n      \"country\": \"840\"\n    }\n  },\n  \"currency\": \"840\",\n  \"timeout\": \"39\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"SC\": 200,\n  \"EC\": \"0\",\n  \"card\": {\n    \"bin\": \"411111\",\n    \"last4\": \"1111\",\n    \"nameFI\": \"Financial Institution Name\",\n    \"pull\": {\n      \"enabled\": true,\n      \"network\": \"Visa\",\n      \"type\": \"Debit\",\n      \"regulated\": true,\n      \"currency\": \"840\",\n      \"country\": \"840\"\n    },\n    \"push\": {\n      \"enabled\": true,\n      \"network\": \"Visa\",\n      \"type\": \"Debit\",\n      \"regulated\": true,\n      \"currency\": \"840\",\n      \"country\": \"840\",\n      \"availability\": \"Immediate\"\n    }\n  }\n}",

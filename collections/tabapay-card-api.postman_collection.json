{
  "item": [
    {
      "id": "826af788-fbe8-41e8-ae74-0d0d8e611ba5",
      "name": "Card",
      "description": {
        "content": "This resource represents a Payment Card (Debit Card, PrePaid Card, or Credit Card).",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "64ffe2c8-e677-4754-82c6-cd8e4f9cd463",
          "name": "Query Card",
          "request": {
            "name": "Query Card",
            "description": {
              "content": "Returns the attributes for the requested Payment Card.\n\nRequest to enable <Glossary>ANI</Glossary> or <Glossary>AVS</Glossary> at [TabaPay Support](https://tabapay.zendesk.com/hc/en-us/requests/new#/) or [help@tabapay.com](mailto:help@tabapay.com)",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "clients",
                ":ClientID",
                "cards"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "AU",
                  "value": "<string>",
                  "description": "Use to send the card number and expiration date to network's Account Updater, and apply any card changes."
                },
                {
                  "disabled": false,
                  "key": "AVS",
                  "value": "<string>",
                  "description": "Use if you would like to perform [<<glossary:AVS>>](https://developers.tabapay.com/docs/address-verification)\n\nIf using in tandem with `Fees` query string, append `?AVS+Fees` or `?Fees+AVS` to your URL. \n\n Request to enable <Glossary>AVS</Glossary> at [TabaPay Support](https://tabapay.zendesk.com/hc/en-us/requests/new#/) or [help@tabapay.com](mailto:help@tabapay.com)"
                },
                {
                  "disabled": false,
                  "key": "ANI",
                  "value": "<string>",
                  "description": "Use if you would like to perform [<<glossary:ANI>>](https://developers.tabapay.com/docs/account-name-inquiry-ani#/)\n\nIf using in tandem with `AVS` query string, append `?ANI+AVS` or `?AVS+ANI` to your URL. \n\n Request to enable <Glossary>ANI</Glossary> at [TabaPay Support](https://tabapay.zendesk.com/hc/en-us/requests/new#/) or [help@tabapay.com](mailto:help@tabapay.com)"
                },
                {
                  "disabled": false,
                  "key": "Fees",
                  "value": "<string>",
                  "description": "Use to check fees.\n\nIf using in tandem with `AVS` query string, append `?Fees+AVS` or `?AVS+Fees` to your URL."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "ClientID",
                  "description": "(Required) 22-character <<glossary:ClientID>>. Ask [TabaPay Support](https://tabapay.zendesk.com/hc/en-us/requests/new) if you need to specify a <<glossary:SubClientID>>."
                },
                {
                  "description": "Contact [TabaPay Support](https://tabapay.zendesk.com/hc/en-us/requests/new) for the Fully Qualified Domain Name you should be using.",
                  "type": "any",
                  "value": "{{FQDN}}",
                  "key": "FQDN"
                },
                {
                  "description": "Ensure you have the capability to access the PORT TabaPay specifies in your credentials file.",
                  "type": "any",
                  "value": "{{PORT}}",
                  "key": "PORT"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"owner\": {\n    \"name\": {\n      \"company\": \"<string>\",\n      \"first\": \"<string>\",\n      \"middle\": \"<string>\",\n      \"last\": \"<string>\",\n      \"suffix\": \"<string>\"\n    },\n    \"address\": {\n      \"line1\": \"<string>\",\n      \"line2\": \"<string>\",\n      \"city\": \"<string>\",\n      \"state\": \"<string>\",\n      \"zipcode\": \"<string>\",\n      \"country\": \"<string>\"\n    }\n  },\n  \"account\": {\n    \"accountID\": \"<string>\",\n    \"securityCode\": \"<string>\"\n  },\n  \"card\": {\n    \"accountNumber\": \"<string>\",\n    \"expirationDate\": \"<string>\",\n    \"securityCode\": \"<string>\",\n    \"keyID\": \"<string>\",\n    \"data\": \"<string>\",\n    \"token\": \"<byte>\",\n    \"device\": {\n      \"id\": \"<string>\",\n      \"blob\": \"<string>\"\n    },\n    \"mobilePay\": {\n      \"accountNumber\": \"<string>\",\n      \"expirationDate\": \"<string>\",\n      \"cryptogram\": \"<byte>\",\n      \"transactionID\": \"<byte>\",\n      \"network\": \"<string>\",\n      \"type\": \"<string>\",\n      \"eciIndicator\": \"<string>\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "81db5c58-c2f6-4c33-aa7a-a2361415184d",
              "name": "The Payment Card's Attributes are returned.",
              "originalRequest": {
                "url": {
                  "path": [
                    "v1",
                    "clients",
                    ":ClientID",
                    "cards"

{
  "opencollection": "1.0.0",
  "info": {
    "name": "TabaPay APIs 3D Secure Client API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Client",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve Client",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{FQDN}:{PORT}/v1/clients/:ClientID",
            "params": [
              {
                "name": "ClientID",
                "value": "",
                "type": "path",
                "description": "22-character ClientID. Present in your credential file."
              }
            ]
          },
          "docs": "Retrieves the attributes and status of a Client."
        }
      ]
    }
  ],
  "bundled": true
}
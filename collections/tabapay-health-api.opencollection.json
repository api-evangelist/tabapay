{
  "opencollection": "1.0.0",
  "info": {
    "name": "TabaPay APIs 3D Secure Health API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Health check",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{FQDN}:{PORT}/health"
          },
          "docs": "Health check"
        },
        {
          "info": {
            "name": "Liveness check",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{FQDN}:{PORT}/health/live"
          },
          "docs": "Liveness check"
        }
      ]
    }
  ],
  "bundled": true
}
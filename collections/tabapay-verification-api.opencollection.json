{
  "opencollection": "1.0.0",
  "info": {
    "name": "TabaPay APIs 3D Secure Verification API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Verification",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Verification",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{FQDN}:{PORT}/v2/clients/:ClientID/verifications",
            "params": [
              {
                "name": "ClientID",
                "value": "",
                "type": "path",
                "description": "22-character <<glossary:ClientID>>. Ask [TabaPay Support](https://tabapay.zendesk.com/hc/en-us/requests/new) if you need to specify a <<glossary:SubClientID>>."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a KYB/KYC verification case. \n\n Request to enable at [TabaPay Support](https://tabapay.zendesk.com/hc/en-us/requests/new#/) or [help@tabapay.com](mailto:help@tabapay.com)"
        },
        {
          "info": {
            "name": "Retrieve Verification",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{FQDN}:{PORT}/v2/clients/:ClientID/verifications/:VerificationID",
            "params": [
              {
                "name": "ClientID",
                "value": "",
                "type": "path",
                "description": "22-character <<glossary:ClientID>>. Ask [TabaPay Support](https://tabapay.zendesk.com/hc/en-us/requests/new) if you need to specify a <<glossary:SubClientID>>."
              },
              {
                "name": "VerificationID",
                "value": "",
                "type": "path",
                "description": "22-character VerificationID returned from Create Verification."
              },
              {
                "name": "referenceID",
                "value": "",
                "type": "query",
                "description": "Reference ID fallback lookup."
              }
            ]
          },
          "docs": "Retrieves a verification by verificationID."
        }
      ]
    }
  ],
  "bundled": true
}
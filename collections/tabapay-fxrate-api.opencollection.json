{
  "opencollection": "1.0.0",
  "info": {
    "name": "TabaPay APIs 3D Secure FXRate API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "FXRate",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Query FX",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{FQDN}:{PORT}/v4/clients/:ClientID/fxrate",
            "params": [
              {
                "name": "ClientID",
                "value": "",
                "type": "path",
                "description": "22-character <<glossary:ClientID>>. Ask [TabaPay Support](https://tabapay.zendesk.com/hc/en-us/requests/new) if you need to specify a <<glossary:SubClientID>>."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "***Currently in sandbox only***\n\nReturns the real-time FX-Rate and the amount in the beneficiary currency."
        }
      ]
    }
  ],
  "bundled": true
}